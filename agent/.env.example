# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Gemini key (aistudio.google.com/apikey): speech-to-text.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Fallback only: VOICE=openai plus
OPENAI_API_KEY=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video
# ElevenLabs (elevenlabs.io > Profile > API Keys): the agent voice. Voice ID optional (premade default).
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=

# Chert Calls API: the agent hangs up the FaceTime when the check is done (AUTO_HANGUP=0 turns it off)
CHERT_API_KEY=
CHERT_PROJECT_ID=
