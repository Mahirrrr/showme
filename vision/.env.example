# Local secrets belong in vision/.env (ignored). Python 3.11+ required.
MOCK=1
AGENT_KEY=
GEMINI_API_KEY=
MONGODB_URI=
MONGODB_DATABASE=showme
GEMINI_MODEL=gemini-3.1-flash-lite
PUBLIC_BASE_URL=http://localhost:5173
LINE_NUMBER=
CHECK_TIMEOUT_SECONDS=20
# Optional fixed camera region: left,top,right,bottom in source-image pixels.
VISION_CROP_BOX=
# Explicit canned result used ONLY when MOCK=1: passed, failed, unverified.
MOCK_RESULT=passed
VISION_FRAME_MODE=camera
VISION_FRAME_SIZE=640,360
VISION_MASK_BOXES=
