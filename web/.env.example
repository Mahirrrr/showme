# Copy to web/.env.local (git-ignored) and fill in. Keys are shared by DM only.
# Server-side only: read by vite.config.ts in Node, never sent to the browser.
GEMINI_API_KEY=
# Optional: the Gemini model for test suggestions
GEMINI_MODEL=gemini-2.5-flash
# 1 = /v/:token and "create" use shared/mock_request.json
VITE_MOCK=1
