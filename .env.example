# Copy to .env and fill in. Never commit .env. Keys are shared by DM only.

# vision/ (Youngjun)
GEMINI_API_KEY=
MONGODB_URI=
AGENT_KEY=            # random 32-character string, same value in vision and agent
PUBLIC_BASE_URL=http://localhost:5173
LINE_NUMBER=          # the Chert FaceTime line, shown on /v/:token
MOCK=1

# agent/ (Mahir)
VISION_URL=http://localhost:8000/api
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=       # Gemini speech-to-text (VOICE=openai + OPENAI_API_KEY to fall back)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CHERT_API_KEY=        # Calls API: hang up the FaceTime when the check is done (AUTO_HANGUP=0 turns it off)
CHERT_PROJECT_ID=
MOCK_VISION=1

# web/ (Wan)
VITE_MOCK=1
